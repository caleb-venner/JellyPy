<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  <RootNamespace>Jellyfin.Plugin.JellyPy</RootNamespace>
  <AssemblyName>Jellyfin.Plugin.JellyPy</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
  <CodeAnalysisRuleSet>../JellyPy.ruleset</CodeAnalysisRuleSet>
    <!-- Suppress nullable reference type warnings - project doesn't use nullable reference types -->
    <NoWarn>$(NoWarn);CS8632</NoWarn>
    <!-- Plugin version information -->
    <Version>2.1.0.0</Version>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <!-- Configurable Jellyfin version for dual-building -->
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">10.10.6</JellyfinVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)"/>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)"/>
    <PackageReference Include="Jellyfin.Common" Version="$(JellyfinVersion)"/>
    <PackageReference Include="Jellyfin.Naming" Version="$(JellyfinVersion)"/>
    <PackageReference Include="Jellyfin.Extensions" Version="$(JellyfinVersion)"/>
    <PackageReference Include="Jellyfin.Data" Version="$(JellyfinVersion)"/>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All"/>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All"/>
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All"/>
  </ItemGroup>
  <ItemGroup>
    <None Remove="Configuration\configPage.html"/>
    <EmbeddedResource Include="Configuration\configPage.html"/>
  </ItemGroup>
</Project>
